{
  "datasets": [
    {
      "name": "record_counts",
      "displayName": "Record Counts by Table",
      "queryLines": [
        "SELECT\n",
        "  'premium_summary' AS table_name,\n",
        "  COUNT(*) AS record_count\n",
        "FROM\n",
        "  premium_summary\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_performance',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_performance\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'customer_performance',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  customer_performance\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'agent_performance',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  agent_performance\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_health\n",
        "ORDER BY\n",
        "  record_count DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "completeness_metrics",
      "displayName": "Data Completeness Metrics",
      "queryLines": [
        "SELECT\n",
        "  'policy_health' AS table_name,\n",
        "  'policy_id' AS field_name,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN policy_id IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  ) AS null_percentage\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  'customer_id',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN customer_id IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  'agent_id',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN agent_id IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  'policy_status',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN policy_status IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  'annual_premium',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN annual_premium IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'premium_summary',\n",
        "  'payment_date',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN payment_date IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  premium_summary\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'premium_summary',\n",
        "  'total_premium_collected',\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN total_premium_collected IS NULL THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  )\n",
        "FROM\n",
        "  premium_summary\n",
        "ORDER BY\n",
        "  null_percentage DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "data_freshness",
      "displayName": "Data Freshness",
      "queryLines": [
        "SELECT\n",
        "  'premium_summary' AS source_table,\n",
        "  MAX(payment_date) AS latest_date,\n",
        "  DATEDIFF(CURRENT_DATE(), MAX(payment_date)) AS days_since_update\n",
        "FROM\n",
        "  premium_summary\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_health',\n",
        "  MAX(policy_start_date),\n",
        "  DATEDIFF(CURRENT_DATE(), MAX(policy_start_date))\n",
        "FROM\n",
        "  policy_health\n",
        "ORDER BY\n",
        "  days_since_update DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "duplicate_detection",
      "displayName": "Duplicate Detection",
      "queryLines": [
        "SELECT\n",
        "  'policy_id in policy_health' AS check_type,\n",
        "  COUNT(*) - COUNT(DISTINCT policy_id) AS duplicate_count\n",
        "FROM\n",
        "  policy_health\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'customer_id in customer_performance',\n",
        "  COUNT(*) - COUNT(DISTINCT customer_id)\n",
        "FROM\n",
        "  customer_performance\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'agent_id in agent_performance',\n",
        "  COUNT(*) - COUNT(DISTINCT agent_id)\n",
        "FROM\n",
        "  agent_performance\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'policy_id in policy_performance',\n",
        "  COUNT(*) - COUNT(DISTINCT policy_id)\n",
        "FROM\n",
        "  policy_performance\n",
        "ORDER BY\n",
        "  duplicate_count DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "value_quality",
      "displayName": "Value Quality Checks",
      "queryLines": [
        "SELECT\n",
        "  'Negative Premium' AS quality_issue,\n",
        "  COUNT(*) AS issue_count\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  annual_premium < 0\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Zero Premium',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  annual_premium = 0\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Negative Outstanding',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  outstanding_premium < 0\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Outlier Premium (>1M)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  annual_premium > 1000000\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Invalid Policy Status',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  policy_status NOT IN ('Active', 'Lapsed', 'Surrendered', 'Matured', 'Expired')\n",
        "ORDER BY\n",
        "  issue_count DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "daily_trends",
      "displayName": "Daily Premium Trends",
      "queryLines": [
        "SELECT\n",
        "  payment_date,\n",
        "  total_premium_collected,\n",
        "  total_payments,\n",
        "  total_policies\n",
        "FROM\n",
        "  premium_summary\n",
        "WHERE\n",
        "  payment_date >= DATE_SUB(CURRENT_DATE(), 90)\n",
        "ORDER BY\n",
        "  payment_date DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "summary_metrics",
      "displayName": "Summary Metrics",
      "queryLines": [
        "SELECT\n",
        "  (\n",
        "    SELECT\n",
        "      SUM(record_count)\n",
        "    FROM\n",
        "      (\n",
        "        SELECT\n",
        "          COUNT(*) as record_count\n",
        "        FROM\n",
        "          premium_summary\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_performance\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          customer_performance\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          agent_performance\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_health\n",
        "      )\n",
        "  ) AS total_records,\n",
        "  (\n",
        "    SELECT\n",
        "      AVG(days_since_update)\n",
        "    FROM\n",
        "      (\n",
        "        SELECT\n",
        "          DATEDIFF(CURRENT_DATE(), MAX(payment_date)) as days_since_update\n",
        "        FROM\n",
        "          premium_summary\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          DATEDIFF(CURRENT_DATE(), MAX(policy_start_date))\n",
        "        FROM\n",
        "          policy_health\n",
        "      )\n",
        "  ) AS avg_data_age_days,\n",
        "  (\n",
        "    SELECT\n",
        "      SUM(duplicate_count)\n",
        "    FROM\n",
        "      (\n",
        "        SELECT\n",
        "          COUNT(*) - COUNT(DISTINCT policy_id) AS duplicate_count\n",
        "        FROM\n",
        "          policy_health\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*) - COUNT(DISTINCT customer_id)\n",
        "        FROM\n",
        "          customer_performance\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*) - COUNT(DISTINCT agent_id)\n",
        "        FROM\n",
        "          agent_performance\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*) - COUNT(DISTINCT policy_id)\n",
        "        FROM\n",
        "          policy_performance\n",
        "      )\n",
        "  ) AS total_duplicates,\n",
        "  (\n",
        "    SELECT\n",
        "      SUM(issue_count)\n",
        "    FROM\n",
        "      (\n",
        "        SELECT\n",
        "          COUNT(*) AS issue_count\n",
        "        FROM\n",
        "          policy_health\n",
        "        WHERE\n",
        "          annual_premium < 0\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_health\n",
        "        WHERE\n",
        "          annual_premium = 0\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_health\n",
        "        WHERE\n",
        "          outstanding_premium < 0\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_health\n",
        "        WHERE\n",
        "          annual_premium > 1000000\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          policy_health\n",
        "        WHERE\n",
        "          policy_status NOT IN ('Active', 'Lapsed', 'Surrendered', 'Matured', 'Expired')\n",
        "      )\n",
        "  ) AS total_quality_issues,\n",
        "  (\n",
        "    SELECT\n",
        "      MAX(null_percentage)\n",
        "    FROM\n",
        "      (\n",
        "        SELECT\n",
        "          ROUND(\n",
        "            100.0\n",
        "              * SUM(\n",
        "                CASE\n",
        "                  WHEN policy_id IS NULL THEN 1\n",
        "                  ELSE 0\n",
        "                END\n",
        "              )\n",
        "              / COUNT(*),\n",
        "            2\n",
        "          ) AS null_percentage\n",
        "        FROM\n",
        "          policy_health\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          ROUND(\n",
        "            100.0\n",
        "              * SUM(\n",
        "                CASE\n",
        "                  WHEN customer_id IS NULL THEN 1\n",
        "                  ELSE 0\n",
        "                END\n",
        "              )\n",
        "              / COUNT(*),\n",
        "            2\n",
        "          )\n",
        "        FROM\n",
        "          policy_health\n",
        "        UNION ALL\n",
        "        SELECT\n",
        "          ROUND(\n",
        "            100.0\n",
        "              * SUM(\n",
        "                CASE\n",
        "                  WHEN agent_id IS NULL THEN 1\n",
        "                  ELSE 0\n",
        "                END\n",
        "              )\n",
        "              / COUNT(*),\n",
        "            2\n",
        "          )\n",
        "        FROM\n",
        "          policy_health\n",
        "      )\n",
        "  ) AS max_null_percentage"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    },
    {
      "name": "policy_status_dist",
      "displayName": "Policy Status Distribution",
      "queryLines": [
        "SELECT\n",
        "  policy_status,\n",
        "  COUNT(*) AS policy_count,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS percentage\n",
        "FROM\n",
        "  policy_health\n",
        "WHERE\n",
        "  policy_status IS NOT NULL\n",
        "GROUP BY\n",
        "  policy_status\n",
        "ORDER BY\n",
        "  policy_count DESC"
      ],
      "catalog": "workspace",
      "schema": "insurance_gold"
    }
  ],
